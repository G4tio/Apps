# ===== EduGrade AI — configuración del servidor =====
# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# URL pública con la que los docentes abren la aplicación (sin barra final).
PUBLIC_URL=http://localhost:3000
PORT=3000

# Secreto para cifrar los tokens de Google y firmar sesiones (mínimo 32 caracteres).
# Si se omite, se genera uno automáticamente en data/.app_secret.
APP_SECRET=

# ---- Inteligencia artificial (API de Anthropic) ----
# Cree la clave en https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
# Modelo multimodal usado para leer y evaluar los PDF.
ANTHROPIC_MODEL=claude-opus-5-5
# Nivel de esfuerzo de razonamiento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# "off" desactiva el reenvío automático a un modelo alternativo cuando el principal declina.
ANTHROPIC_FALLBACKS=on

# ---- Google Drive (OAuth 2.0) ----
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un "URI de redireccionamiento autorizado" del cliente OAuth.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/oauth/callback

# ---- Cola de evaluación ----
# Documentos evaluados en paralelo y reintentos ante fallos temporales.
EVAL_CONCURRENCY=2
EVAL_MAX_ATTEMPTS=4

# Carpeta de datos (base de datos SQLite y copias temporales de los PDF).
DATA_DIR=./data

# Orígenes desde los que se permite usar el archivo edugrade.html descargado.
# "*" (por defecto) lo permite desde cualquier lugar, incluido abrirlo con doble clic.
# Para restringirlo: ALLOWED_ORIGINS=https://mi-colegio.github.io,null
ALLOWED_ORIGINS=*
